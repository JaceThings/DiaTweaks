#!/bin/sh
# Compare the same AppKit fixture against the upstream base and this checkout.
set -eu
cd "$(dirname "$0")/.."
base="${1:-9d5a57061996840a9c7686bee756be09b317e441}"
baseline="$PWD/build/performance-baseline"
mkdir -p "$baseline"
git archive "$base" src/dylib | tar -x -C "$baseline"
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
for variant in before after; do
    source="$PWD/src/dylib"
    define="-DDP_OPTIMIZED"
    if [ "$variant" = before ]; then source="$baseline/src/dylib"; define=""; fi
    clang -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter $define -I"$source" \
        -framework AppKit -framework QuartzCore tests/toolbar-performance.m \
        "$source/Patches/HideToolbar/Layout.m" "$source/Patches/HideToolbar/Hover.m" \
        "$source/StdPatch/Views.m" -o "build/toolbar-$variant"
    echo "$variant ($base baseline)"
    "build/toolbar-$variant"
    clang -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter $define -I"$source" \
        -framework AppKit -framework QuartzCore tests/restyle-coalescing.m \
        "$source/StdPatch/Views.m" "$source/StdPatch/Hook.m" -o "build/restyle-$variant"
    "build/restyle-$variant"
done

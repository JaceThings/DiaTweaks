set(DT_CATALOG "${CMAKE_CURRENT_SOURCE_DIR}/../shared/features.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DT_CATALOG}")
file(READ "${DT_CATALOG}" catalog)
string(JSON count LENGTH "${catalog}" features)
math(EXPR last "${count} - 1")
set(header "#pragma once\nnamespace dt {\nstruct Feature { const wchar_t *key, *title, *detail, *section, *requiresKey, *disabledBy, *kind; bool defaultOn; };\ninline constexpr Feature Features[] = {\n")
foreach(i RANGE 0 ${last})
  set(row "{")
  foreach(field key title detail section requires disabledBy kind)
    string(JSON value GET "${catalog}" features ${i} ${field})
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(APPEND row "L\"${value}\", ")
  endforeach()
  string(JSON default GET "${catalog}" features ${i} defaultOn)
  if(default)
    string(APPEND row "true},\n")
  else()
    string(APPEND row "false},\n")
  endif()
  string(APPEND header "${row}")
endforeach()
string(APPEND header "};\n}\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/feature_catalog.h" "${header}")
set(wand "${CMAKE_CURRENT_SOURCE_DIR}/settings/assets/wand_20_regular.svg")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wand}")
file(READ "${wand}" svg)
string(REGEX MATCH "<path d=\"([^\"]+)\"" ignored "${svg}")
if(NOT CMAKE_MATCH_1)
  message(FATAL_ERROR "Fluent wand asset has no path data")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/wand_icon.h" "#pragma once\n// Microsoft Fluent System Icons: see settings/assets/LICENSE.fluent-icons.\nnamespace dt { inline constexpr wchar_t WandPath[] = L\"${CMAKE_MATCH_1}\"; }\n")

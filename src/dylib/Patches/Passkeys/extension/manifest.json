{
  "manifest_version": 3,
  "name": "DiaTweaks Passkeys",
  "description": "Signs in with passkeys saved in Apple Passwords.",
  "version": "1",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true },
    { "matches": ["https://*/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
